{% extends "base.html.j2" %}

{#
  Stardew theme: the cover sits in a side tab (tab_border_side.png) attached
  to a dialogue box (tooltip_border.png) that holds the text and the bars,
  like the side tabs of the portfolio. Pixel font embedded.
  Assets come base64-encoded from api/theme_assets.py (the SVG cannot load files).
  Layout numbers come from THEME_LAYOUTS in config.py (the "style" variable),
  the same numbers the equalizer bar geometry uses.
#}

{% block container_styles %}
/* Stardew theme - no frame on the container: the tab and the box have their own */
background: transparent;
border: none;
border-radius: 0;
{% endblock %}

{% block theme_styles %}
{% set tab = style.tab_frame %}
{% set box = style.box_frame %}
@font-face {
    font-family: 'StardewValley';
    src: url("data:font/woff2;base64,{{ assets.font_regular }}") format('woff2');
    font-weight: normal;
    font-style: normal;
}

@font-face {
    font-family: 'StardewValleyBold';
    src: url("data:font/woff2;base64,{{ assets.font_bold }}") format('woff2');
    font-weight: bold;
    font-style: normal;
}

div {
    font-family: 'StardewValley', 'Courier New', monospace;
}

/* Cover tab: frame on top/left/bottom, open (thin) on the right where it
   meets the box. Pixel art at 2x drawn at half size: crisp pixels. */
.art {
    width: {{ album_size + tab.left + tab.right + 2 * style.tab_padding }}px;
    height: {{ album_size + tab.top + tab.bottom + 2 * style.tab_padding }}px;
    padding: {{ style.tab_padding }}px;
    background-color: #ffc878;
    background-clip: padding-box;
    border-style: solid;
    border-width: {{ tab.top }}px {{ tab.right }}px {{ tab.bottom }}px {{ tab.left }}px;
    border-image-source: url("data:image/png;base64,{{ assets.tab }}");
    border-image-slice: 16 4 16 16;
    border-image-repeat: stretch;
    image-rendering: pixelated;
}

/* Dialogue box around the text and the bars */
.content {
    align-self: stretch;
    justify-content: center;
    padding: 0 {{ style.box_padding_x }}px;
    background-color: #ffc878;
    background-clip: padding-box;
    border-style: solid;
    border-width: {{ box.top }}px {{ box.right }}px {{ box.bottom }}px {{ box.left }}px;
    border-image-source: url("data:image/png;base64,{{ assets.border }}");
    border-image-slice: 16 16 16 12;
    border-image-repeat: stretch;
    image-rendering: pixelated;
}

/* Links take the content width, so scrolling titles are clipped before the
   box padding instead of running into the frame */
.content > a {
    width: 100%;
}

/* Solid dark-brown text with the game's offset shadow (no gradient) */
.song-text,
.artist-text,
.status {
    background: none;
    -webkit-text-fill-color: #331f28;
    color: #331f28;
    animation: none;
    filter: none;
}

.song-text {
    font-family: 'StardewValleyBold', 'StardewValley', monospace;
    font-weight: bold;
    text-shadow: #ce9c5f -2px 1px;
}

.artist-text {
    text-shadow: #ce9c5f -1px 1px;
}

.status {
    opacity: 1;
    font-size: {{ 12 if is_compact else 16 }}px;
    margin-bottom: {{ 0 if is_compact else 2 }}px;
    text-shadow: #ce9c5f -1px 1px;
}

{% if is_compact %}
/* Compact: 64px of box height for status + song + artist + bars */
.song, .artist, .status {
    line-height: 1.05;
}
{% endif %}

/* The tab is the cover's frame */
.cover,
.container.blur-bg .cover,
.art:hover .cover {
    border-radius: 0;
    box-shadow: none;
    transform: none;
    image-rendering: pixelated;
}

{% endblock %}
